# Copy this file to .env. Never commit .env or share its values.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_CRYPTO_RANDOMBYTES
DB_PATH=./data/smh.sqlite
TRUST_PROXY=0

# Optional SMTP for verification and password-recovery emails. Without SMTP, development links print in the server terminal.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=SMH Collections <no-reply@example.com>

# Optional public store settings
STORE_NAME=SMH Collections
STORE_CURRENCY=PKR
